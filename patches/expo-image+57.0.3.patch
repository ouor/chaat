+  // chaat patch: decode GIFs with Glide's own GifDrawable instead of the penfeizhou glide-plugin.
+  // The plugin's FrameAnimationDrawable has no ConstantState, so Glide's memory cache hands the
+  // same Drawable instance (and FrameSeqDecoder) to every view showing that GIF; each view's
+  // start()/stop() then restarts or tears down the shared decoder (re-decoding the GIF and
+  // logging "Processing,wait for finish" ~10x/s in a busy chat). Glide's GifDrawable gives each
+  // view its own drawable over a shared, ref-counted frame loader. The app module is applied
+  // after library modules, so these prepends win over the plugin's; other formats are untouched.
+  override fun registerComponents(context: Context, glide: Glide, registry: Registry) {
+    super.registerComponents(context, glide, registry)
+    val byteBufferGifDecoder =
+      ByteBufferGifDecoder(context, registry.imageHeaderParsers, glide.bitmapPool, glide.arrayPool)
+    registry.prepend(ByteBuffer::class.java, GifDrawable::class.java, byteBufferGifDecoder)
+    registry.prepend(
+      InputStream::class.java,
+      GifDrawable::class.java,
+      StreamGifDecoder(registry.imageHeaderParsers, byteBufferGifDecoder, glide.arrayPool)
+    )
+  }
